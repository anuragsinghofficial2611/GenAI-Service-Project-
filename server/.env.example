# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Connection
# Example local: mongodb://127.0.0.1:27017/rag_chatbot
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/rag_chatbot?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/rag_chatbot

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_rag_production_replace_this_with_your_own_secure_key
JWT_EXPIRES_IN=7d

# Google Gemini API
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone Vector Database
# Get your free key and create an index at: https://app.pinecone.io/
# Ensure your index dimension is set to 768 (matching Google text-embedding-004) with cosine metric
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=rag-docs
